# Variable reference only; the server does not load .env files.
# Inject real values through your environment or secret manager.
# example.invalid is reserved and does not identify a real instance.
SERVICENOW_INSTANCE=https://servicenow.example.invalid
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
PORT=3001
# Optional additional hostnames forwarded by your HTTPS proxy; no scheme or port.
MCP_ALLOWED_HOSTS=
# Optional exact browser origins. Empty rejects requests carrying an Origin header.
MCP_ALLOWED_ORIGINS=
